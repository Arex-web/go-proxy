# Copy to .env and edit — the server loads .env automatically.
# You can also use the shell: PROXY_ADDR=... ./run.sh
# Priority: command-line flags > exported env vars > .env file

# Port / listen address (one of these):
PROXY_ADDR=0.0.0.0:1080
# PROXY_PORT=1080
# PORT=1080

# Auth (leave empty for no auth / public proxy):
PROXY_USERNAME=myuser
PROXY_PASSWORD=change-me-strong-password

# Optional:
# PROXY_ENV_FILE=.env

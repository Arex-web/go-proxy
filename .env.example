# Copy to .env and edit — the server loads .env automatically.
# You can also use the shell: PROXY_ADDR=... ./run.sh
# Priority: command-line flags > exported env vars > .env file

# Port / listen address (one of these):
PROXY_ADDR=0.0.0.0:1080
# PROXY_PORT=1080
# PORT=1080

# Auth (leave empty for no auth / public proxy):
PROXY_USERNAME=myuser
PROXY_PASSWORD=change-me-strong-password

# Telegram MTProto (optional; leave empty to disable).
# Powered by github.com/9seconds/mtg. Only fake-TLS ("ee") secrets are
# accepted; the secret carries the domain-fronting hostname.
# Generate one with:  ./proxy-server -gen-secret [-gen-host www.google.com]
# Multiple secrets may be comma-separated.
# MTPROTO_SECRET=ee<32 hex><domain hex>
#
# MTProto is always accepted on PROXY_ADDR (shared with SOCKS5/HTTP).
# Optionally add a dedicated MTProto-only listener too:
# MTPROTO_ADDR=0.0.0.0:8443

# Optional:
# PROXY_ENV_FILE=.env

# Example env file - copy to .env (dev) or /etc/proxy-server/proxy.env (service).
# Flags always win over these values.

# Listen address. PROXY_PORT / PORT are accepted aliases, bare ports too.
PROXY_ADDR=0.0.0.0:1080
# PROXY_PORT=1080

# Optional proxy authentication (HTTP Basic + SOCKS5 user/pass).
PROXY_USERNAME=myuser
PROXY_PASSWORD=change-me-strong-password

# Dial / sniff timeout for SOCKS5 and HTTP (Go duration).
# PROXY_TIMEOUT=30s

# Verbose logging, including mtg internals and the MTProto event stream.
# PROXY_VERBOSE=false

# ── Telegram MTProto (fake-TLS "ee" secrets, powered by mtg) ──────────────────
# Generate one with: ./cmd.sh -gen-secret
# MTPROTO_SECRET=ee<32 hex><domain hex>
# Optional extra MTProto-only port (the main port always serves MTProto).
# MTPROTO_ADDR=0.0.0.0:8443

# Everything below maps 1:1 to mtg's configuration file; unset = mtg default.
# MTPROTO_SECRET_HOST=www.google.com     # fronting host baked into new secrets
# MTPROTO_CONCURRENCY=4096               # simultaneous streams per secret
# MTPROTO_FRONTING_PORT=443              # port used for domain fronting
# MTPROTO_FRONTING_HOST=                 # dial target for fronting (SNI stays the secret host)
# MTPROTO_PREFER_IP=prefer-ipv6          # prefer-ipv4 | prefer-ipv6 | only-ipv4 | only-ipv6
# MTPROTO_ALLOW_FALLBACK_DC=false        # use any DC for unknown DC ids
# MTPROTO_AUTOUPDATE=false               # refresh the Telegram DC list in the background
# MTPROTO_IDLE_TIMEOUT=5m                # close idle relays
# MTPROTO_HANDSHAKE_TIMEOUT=10s          # limit for the complete handshake
# MTPROTO_TOLERATE_SKEW=3s               # accepted fake-TLS timestamp skew
# MTPROTO_DOPPELGANGER_DRS=false         # TLS dynamic record sizing
